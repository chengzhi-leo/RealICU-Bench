{
  "protocol": "realicu-v1",
  "task": "recommendation",
  "labels_dir": "data/realicu/gold/labels",
  "execution": {
    "num_workers": 1
  },
  "evaluation": {
    "top_k_actions": 5
  },
  "matcher": {
    "backend": "pubmedbert",
    "encoder": {
      "model_name": "NeuML/pubmedbert-base-embeddings",
      "device": "cpu",
      "batch_size": 64,
      "local_files_only": false
    },
    "similarity_threshold": 0.5
  }
}
